#!/usr/bin/env sh
# Shortcuts for the Docker development environment.
# Usage: ./dev <command> [arguments]   (run ./dev help for the list)
set -e

cd "$(dirname "$0")"

COMPOSE="docker compose"

usage() {
    cat <<'EOF'
Usage: ./dev <command> [arguments]

Environment:
  up [args]          Start all services in the background (docker compose up -d)
  down [args]        Stop and remove the containers
  stop               Stop the containers without removing them
  restart [service]  Recreate all services or one service (reruns their startup steps)
  rebuild [service]  Rebuild the images and recreate the services
  build [args]       Rebuild the images without restarting
  ps                 Show the running services
  logs [service]     Follow the logs of all services or one service
  reset              Remove the containers AND the database volume

Backend (Laravel):
  artisan <args>     Run an Artisan command, e.g. ./dev artisan route:list
  composer <args>    Run Composer in the backend container
  modules:search [owner]
                     List the GitHub repositories with the topic jalaops-module (Python
                     module packages) and how to install each; default owner: your gh account
  migrate            Run database migrations
  fresh              Drop all tables, migrate and seed the database
  shell              Open a shell in the backend container
  db                 Open the MariaDB client

Frontend (Vue):
  npm <args>         Run npm in the frontend container

Android app:
  android            Build android/dist/jalaops.apk and jalaops.aab (needs only Docker)
  android-secrets    Store the upload key in GitHub secrets for the release workflow

Backend on Google Cloud Run (needs gcloud and GCP_PROJECT_ID; see docs/DEPLOYMENT.md).
Each command also makes GCP_PROJECT_ID gcloud's active project.
  gcloud:login       Sign in to Google Cloud
  deploy [args]      Deploy the backend to Cloud Run
  gcloud:status      Show the account, the backend's address and revision, and its setting names
  gcloud:logs [n]    Show the backend's latest n log entries (default 50)
  gcloud:set-env <KEY=VALUE,...>
                     Set environment variables on the backend (keep keys in Secret Manager)

Frontend on Vercel (needs the vercel CLI; see docs/DEPLOYMENT.md):
  vercel:login       Sign in to Vercel and link this folder to the project
  vercel:deploy [args]
                     Deploy the working copy as a preview; --prod deploys to production
  vercel:status      Show the latest deployments
  vercel:logs [args] Show the frontend's request logs (e.g. --follow, --since 1h)
  vercel:env         List the project's environment variable names

Tests:
  test               Run the backend and frontend tests
  test:backend       Run the backend tests
  test:frontend      Run the frontend tests

Any other command is passed to docker compose, e.g. ./dev exec backend php -v
EOF
}

# Deployment settings for the gcloud:* and vercel:* commands, from the
# environment or ~/.jalaops/deploy.env (outside the repository). Variables
# already in the environment win over the file.
settings="${JALAOPS_DEPLOY_ENV:-$HOME/.jalaops/deploy.env}"
deploy_settings() {
    exported="$(export -p)"
    # shellcheck disable=SC1090
    [ -f "$settings" ] && . "$settings"
    eval "$exported"
}

# GCP_PROJECT_ID (or PROJECT_ID, as in docs/DEPLOYMENT.md) is required, so a
# deploy never goes to whatever project gcloud happens to have active. When
# gcloud's active project is another one, it's switched to this one, so plain
# gcloud commands use it too.
gcloud_settings() {
    command -v gcloud > /dev/null || { echo "gcloud not found; install the Google Cloud CLI: https://cloud.google.com/sdk/docs/install"; exit 1; }
    deploy_settings
    project="${GCP_PROJECT_ID:-${PROJECT_ID:-}}"
    region="${CLOUD_RUN_REGION:-europe-north1}"
    service="${CLOUD_RUN_SERVICE:-jalaops-backend}"
    if [ -z "$project" ]; then
        echo "GCP_PROJECT_ID is not set. Add it to $settings, e.g.:"
        echo "  mkdir -p \"$(dirname "$settings")\" && echo GCP_PROJECT_ID=my-project-id >> \"$settings\""
        echo "Use the project ID, not its name (gcloud projects list)."
        exit 1
    fi
    if [ "$(gcloud config get-value project 2>/dev/null)" != "$project" ]; then
        echo "Setting gcloud's active project to $project."
        gcloud config set project "$project" --quiet
    fi
}

# VERCEL_PROJECT (default jalaops) and the optional VERCEL_SCOPE, the team
# slug (vercel teams ls). The Vercel project's root directory is frontend/,
# so the CLI runs and links in the repository root.
vercel_settings() {
    command -v vercel > /dev/null || { echo "vercel not found; install it with: npm i -g vercel"; exit 1; }
    deploy_settings
    vercel_project="${VERCEL_PROJECT:-jalaops}"
    scope="${VERCEL_SCOPE:+--scope=$VERCEL_SCOPE}"
}

# Links this folder to the project if it isn't linked yet; deploy and env
# need it. Linking writes .vercel/ and .env.local (a short-lived Vercel token),
# both ignored by git.
vercel_link() {
    [ -f .vercel/project.json ] || vercel link --yes --project "$vercel_project" $scope
}

command="${1:-help}"
[ $# -gt 0 ] && shift

case "$command" in
    up)            $COMPOSE up -d "$@" ;;
    down)          $COMPOSE down "$@" ;;
    stop)          $COMPOSE stop "$@" ;;
    restart)       $COMPOSE up -d --force-recreate "$@" ;;
    rebuild)       $COMPOSE up -d --build --force-recreate "$@" ;;
    build)         $COMPOSE build "$@" ;;
    ps)            $COMPOSE ps "$@" ;;
    logs)          $COMPOSE logs -f "$@" ;;
    reset)         $COMPOSE down -v "$@" ;;
    artisan)       $COMPOSE exec backend php artisan "$@" ;;
    composer)      $COMPOSE exec backend composer "$@" ;;
    migrate)       $COMPOSE exec backend php artisan migrate "$@" ;;
    fresh)         $COMPOSE exec backend php artisan migrate:fresh --seed "$@" ;;
    shell)         $COMPOSE exec backend bash ;;
    db)            $COMPOSE exec db mariadb -u jalaops -psecret jalaops ;;
    npm)           $COMPOSE exec frontend npm "$@" ;;
    modules:search)
        # Module packages (backend/modules/README.md) are found by their GitHub
        # topic, and each one's package name is read from its composer.json.
        command -v gh > /dev/null || { echo "gh not found; install the GitHub CLI: https://cli.github.com"; exit 1; }
        owner="${1:-$(gh api user --jq .login)}"
        repos="$(gh repo list "$owner" --topic jalaops-module --limit 200 --json nameWithOwner,url --jq '.[] | "\(.nameWithOwner) \(.url)"')"
        [ -n "$repos" ] || { echo "No repositories of $owner have the topic jalaops-module."; exit 0; }
        echo "$repos" | while read -r repo url; do
            manifest="$(gh api "repos/$repo/contents/composer.json" --jq .content 2>/dev/null | base64 -d 2>/dev/null || true)"
            package="$(echo "$manifest" | sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p' | head -1)"
            if [ -z "$package" ] || ! echo "$manifest" | grep -q '"type": *"jalaops-module"'; then
                echo "$repo: not a module package (needs a composer.json with \"type\": \"jalaops-module\")"
            elif grep -q "\"$package\"" backend/composer.json; then
                echo "$repo: $package, installed"
            else
                echo "$repo: $package, install with"
                echo "    ./dev composer config repositories.${repo#*/} vcs $url.git && ./dev composer require $package"
            fi
        done
        ;;
    android)
        # Builds in the jalaops-android image (Node, Java 17, Android SDK, Bubblewrap).
        # The upload key stays outside the repository, in ~/.jalaops/android.
        keys="${JALAOPS_ANDROID_KEYS:-$HOME/.jalaops/android}"
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/jalaops-android"
        mkdir -p "$keys" "$cache"
        docker build -q -t jalaops-android docker/android > /dev/null
        docker run --rm -u "$(id -u):$(id -g)" -e HOME=/home/builder -e GRADLE_USER_HOME=/home/builder/.gradle \
            -v "$PWD:/work" -v "$keys:/keys" -v "$cache:/home/builder" -w /work \
            jalaops-android scripts/android/docker-build.sh
        ;;
    android-secrets)
        # Uploads the key and its passwords to the repository's GitHub secrets
        # (with the gh CLI), so the Android workflow can sign release builds.
        keys="${JALAOPS_ANDROID_KEYS:-$HOME/.jalaops/android}"
        [ -f "$keys/upload.jks" ] || { echo "No key in $keys; run ./dev android first."; exit 1; }
        base64 -w0 "$keys/upload.jks" | gh secret set ANDROID_KEYSTORE_BASE64
        sed -n 's/^ANDROID_KEYSTORE_PASSWORD=//p' "$keys/signing.env" | gh secret set ANDROID_KEYSTORE_PASSWORD
        sed -n 's/^ANDROID_KEY_PASSWORD=//p' "$keys/signing.env" | gh secret set ANDROID_KEY_PASSWORD
        echo "Stored ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD and ANDROID_KEY_PASSWORD in GitHub secrets."
        ;;
    gcloud:login)
        gcloud_settings
        gcloud auth login "$@"
        ;;
    deploy)
        # Builds backend/Dockerfile with Cloud Build and deploys a new revision to
        # Cloud Run. The service keeps its other settings; extra arguments go to
        # gcloud run deploy.
        gcloud_settings
        echo "Deploying $service to Cloud Run (project $project, region $region)."
        gcloud run deploy "$service" --source backend --region "$region" --project "$project" "$@"
        ;;
    gcloud:status)
        # Only the names of the environment variables, never their values.
        gcloud_settings
        echo "Account:  $(gcloud config get-value account 2>/dev/null)"
        echo "Project:  $project ($region)"
        gcloud run services describe "$service" --region "$region" --project "$project" \
            --format='value[separator="
"](format("Address:  {0}", status.url), format("Revision: {0}", status.latestReadyRevisionName), format("Settings: {0}", spec.template.spec.containers[0].env[].name.list()))'
        ;;
    gcloud:logs)
        gcloud_settings
        gcloud run services logs read "$service" --region "$region" --project "$project" --limit "${1:-50}"
        ;;
    gcloud:set-env)
        # Creates a new revision with the changed variables; the others stay.
        [ $# -gt 0 ] || { echo "Usage: ./dev gcloud:set-env KEY=VALUE[,KEY=VALUE...]"; exit 1; }
        gcloud_settings
        gcloud run services update "$service" --region "$region" --project "$project" --update-env-vars "$@"
        ;;
    vercel:login)
        vercel_settings
        vercel login "$@"
        vercel link --yes --project "$vercel_project" $scope
        ;;
    vercel:deploy)
        # Pushes to main deploy to production automatically; this is for trying
        # out the working copy, or a production deploy by hand with --prod.
        vercel_settings
        vercel_link
        vercel deploy $scope "$@"
        ;;
    vercel:status)
        vercel_settings
        vercel list "$vercel_project" $scope "$@"
        ;;
    vercel:logs)
        vercel_settings
        vercel logs --project "$vercel_project" $scope "$@"
        ;;
    vercel:env)
        # Only the names and their environments, never the values.
        vercel_settings
        vercel_link
        vercel env ls $scope --format=json | node -e '
            let json = ""
            process.stdin.on("data", (chunk) => (json += chunk)).on("end", () => {
                for (const env of JSON.parse(json).envs) console.log(`${env.key}  (${[].concat(env.target).join(", ")})`)
            })'
        ;;
    test)
        $COMPOSE exec backend php artisan test
        $COMPOSE exec frontend npm run test
        ;;
    test:backend)  $COMPOSE exec backend php artisan test "$@" ;;
    test:frontend) $COMPOSE exec frontend npm run test -- "$@" ;;
    help|-h|--help) usage ;;
    *)             $COMPOSE "$command" "$@" ;;
esac
