# Where the Vite dev server forwards /api requests (the Laravel backend).
API_PROXY_TARGET=http://localhost:8000

# Link to the API documentation served by the Laravel backend (shown in the footer).
VITE_API_DOCS_URL=http://localhost:8000/docs

# Public address of the frontend for the link preview tags in index.html
# (canonical, og:url, og:image). Defaults to http://localhost:5173.
VITE_SITE_URL=http://localhost:5173

# Show the Mobiilisovellukset page (/mobile-apps) and its links in the footer and
# on the About page. Off unless "true"; without it /mobile-apps opens the home page.
VITE_MOBILE_APPS_PAGE=false
