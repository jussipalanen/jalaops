APP_NAME=JalaOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Address of the Vue app; the backend home page (/) links to it, and the QR
# code on a request's PDF and HTML opens the request there.
FRONTEND_URL=http://localhost:5173
# Only the app's own pages may call the API from a browser (CORS) and use the
# AI-tilannekatsaus: FRONTEND_URL, APP_URL and these extra addresses
# (comma-separated, no trailing slash), e.g. a Vercel preview address.
# ALLOWED_ORIGINS=https://jalaops.vercel.app

# Pre-filled values for new rows of work and materials (Työt ja tarvikkeet).
# DEFAULT_VAT_RATE: VAT percent (Finland's general rate 25.5 %).
# DEFAULT_HOURLY_RATE: euros per hour for work, without VAT.
# DEFAULT_VAT_RATE=25.5
# DEFAULT_HOURLY_RATE=65

# Invoices: the seller shown on them and the first invoice number. The defaults
# are made up for the demo; set your own details and bank account for real use.
# SELLER_NAME="JalaOps Demo"
# SELLER_BUSINESS_ID=
# SELLER_STREET_ADDRESS="Esimerkkikatu 1"
# SELLER_POSTAL_CODE=00100
# SELLER_CITY=Helsinki
# SELLER_EMAIL=laskutus@jalaops.example.com
# SELLER_IBAN and SELLER_BIC are also in the invoices' payment QR code, which
# is off for now: INVOICE_PAYMENT_QR=true turns it on (it also needs SELLER_IBAN).
# SELLER_IBAN=
# SELLER_BIC=
# FIRST_INVOICE_NUMBER=1001
# INVOICE_PAYMENT_QR=false

# Time zone for the times in downloaded PDF and HTML files (the app stores UTC).
# DISPLAY_TIMEZONE=Europe/Helsinki

# The "Tietoja" page (GET /api/system) shows PHP, Laravel and database versions
# only when this is true. Defaults to true when APP_ENV=local, false elsewhere.
# SHOW_SYSTEM_DETAILS=true

# Demo mode (used by the production image, see backend/docker/start.sh):
# true  = local demo data in SQLite, reset on every server start; DB_* below is ignored.
# false = use the database configured with DB_* below and keep its data.
DEMO_MODE=false
# With DEMO_MODE=false: true adds the demo requests once, into an empty table.
SEED_DEMO_DATA=false

# AI-tilannekatsaus: an AI-written summary of the requests on the dashboard.
# AI_INSIGHTS_ENABLED: true shows it; it also needs the key of the chosen provider.
# AI_INSIGHTS_PROVIDER: which AI to use: gemini (Google Gemini) or puter (Puter AI).
AI_INSIGHTS_ENABLED=false
AI_INSIGHTS_PROVIDER=gemini
# Reuse an overview this many minutes while the requests stay the same.
AI_INSIGHTS_CACHE_MINUTES=60
# At most this many AI calls per hour for the whole app (keeps within free limits).
AI_INSIGHTS_MAX_PER_HOUR=20

# Google Gemini (AI_INSIGHTS_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL: which Gemini model writes the overview. Options:
#   gemini-3.1-flash-lite  fast, free tier (default)
#   gemini-3.8-flash       newer and stronger; check the free tier limits
#   gemini-2.5-flash       older Flash model
# All models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite

# Puter AI (AI_INSIGHTS_PROVIDER=puter). Create a token at https://puter.com/dashboard.
# Server-side use needs a Puter subscription (otherwise: 402 subscription_required).
PUTER_AUTH_TOKEN=
# PUTER_MODEL: which model on Puter writes the overview. Options:
#   google/gemma-4-31b-it  listed at $0 (default)
#   qwen/qwen3.7-flash     very cheap, good JSON output
#   openai/gpt-5.4-nano    small OpenAI model
# All models: https://developer.puter.com/ai/models/
PUTER_MODEL=google/gemma-4-31b-it

# Address search for request locations ("Hae koordinaatit osoitteesta") uses
# Nominatim, OpenStreetMap's free geocoder. No key is needed, but its usage
# policy requires a User-Agent that identifies the app; set your own contact URL.
NOMINATIM_USER_AGENT="JalaOps demo (https://github.com/jussipalanen/jalaops)"

APP_LOCALE=fi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fi_FI

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the MariaDB service in docker-compose.yml. Inside Docker,
# docker-compose.yml sets DB_HOST=db, which takes precedence over this file.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jalaops
DB_USERNAME=jalaops
DB_PASSWORD=secret
# Path to the CA certificate for hosted databases that require SSL (e.g. Aiven).
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
