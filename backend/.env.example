APP_NAME=JalaOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Demo mode (used by the production image, see docker/production/start.sh):
# true  = local demo data in SQLite, reset on every server start; DB_* below is ignored.
# false = use the database configured with DB_* below and keep its data.
DEMO_MODE=false
# With DEMO_MODE=false: true adds the demo requests once, into an empty table.
SEED_DEMO_DATA=false

APP_LOCALE=fi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fi_FI

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the MariaDB service in docker-compose.yml. Inside Docker,
# docker-compose.yml sets DB_HOST=db, which takes precedence over this file.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jalaops
DB_USERNAME=jalaops
DB_PASSWORD=secret
# Path to the CA certificate for hosted databases that require SSL (e.g. Aiven).
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

